# ==========================================
# FileMaster Tools - Environment Configuration
# ==========================================

# Application Port and Host
PORT=3000
NODE_ENV=production
APP_URL="https://filemastertools.com"

# Database Connection (PostgreSQL / Cloud SQL / Neon / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/filemaster_db?sslmode=require"

# JWT and Session Authentication
AUTH_SECRET="your-super-secret-jwt-or-session-encryption-key-min-32-chars"
ADMIN_INITIAL_EMAIL="admin@filemaster.com"
ADMIN_INITIAL_PASSWORD="ChangeMeInProduction123!"

# Cloud Object Storage (S3 / Cloudflare R2 / Google Cloud Storage)
STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
STORAGE_BUCKET="filemaster-uploads"
STORAGE_ACCESS_KEY="YOUR_OBJECT_STORAGE_ACCESS_KEY"
STORAGE_SECRET_KEY="YOUR_OBJECT_STORAGE_SECRET_KEY"
STORAGE_REGION="us-east-1"

# Payment Gateways (Razorpay for India & International / Stripe)
PAYMENT_KEY_ID="rzp_live_your_key_id"
PAYMENT_KEY_SECRET="your_razorpay_key_secret"
PAYMENT_WEBHOOK_SECRET="your_payment_webhook_secret_signature"

# Analytics & Search Engine Optimization
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
GOOGLE_SEARCH_CONSOLE_VERIFICATION="google-site-verification=XXXXXXXXXXXXXXXXXXXX"

# Gemini AI API (Optional server-side AI OCR / Smart extraction)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
